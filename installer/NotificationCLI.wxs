<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
    Name="Notification CLI"
    Manufacturer="Luc Vo Van"
    Version="$(var.ProductVersion)"
    UpgradeCode="92E733DB-36E5-4CBF-B7A5-6B350D219523"
    Scope="perMachine">
    <MajorUpgrade DowngradeErrorMessage="A newer version of Notification CLI is already installed." />

    <!--
      Without EmbedCab the payload is written next to the .msi as cab1.cab, so
      the installer fails wherever the two are separated - which is every
      download of a single file from a build artifact.
    -->
    <MediaTemplate EmbedCab="yes" />

    <Feature Id="MainFeature">
      <ComponentRef Id="NotifyExecutable" />
    </Feature>
  </Package>

  <Fragment>
    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="Notification CLI" />
    </StandardDirectory>
  </Fragment>

  <Fragment>
    <Component Id="NotifyExecutable" Directory="INSTALLFOLDER" Guid="2DC27661-96C7-4683-A305-80A60F72E37D">
      <File Id="NotifyExe" Name="notify.exe" Source="$(var.NotifyExecutable)" KeyPath="yes" />
      <!--
        Appended to the machine PATH, which every user account inherits, and
        removed again on uninstall. Already-open shells keep their old copy of
        the environment until they are restarted.
      -->
      <Environment
        Id="AddInstallFolderToPath"
        Name="PATH"
        Value="[INSTALLFOLDER]"
        Action="set"
        Part="last"
        Separator=";"
        System="yes"
        Permanent="no" />
    </Component>
  </Fragment>
</Wix>
